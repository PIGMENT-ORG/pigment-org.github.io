<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Blog - PIGMENT</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Unbounded:wght@300;400;700;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --ink: #0a0a0a;
            --paper: #f0ede6;
            --dim: #b8b4ac;
            --accent: #c8ff00;
            --mono: 'DM Mono', monospace;
            --display: 'Unbounded', sans-serif;
        }

        body {
            background: var(--ink);
            color: var(--paper);
            font-family: var(--mono);
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header - Sticky */
        .blog-header {
            background: rgba(10,10,10,0.98);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #1a1a1a;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo a {
            font-family: var(--display);
            font-weight: 900;
            font-size: clamp(1.2rem, 4vw, 1.5rem);
            color: var(--accent);
            text-decoration: none;
        }

        .logo span {
            color: var(--dim);
        }

        .header-nav {
            display: flex;
            gap: clamp(1rem, 3vw, 2rem);
            align-items: center;
        }

        .header-nav a {
            color: var(--dim);
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.2s;
        }

        .header-nav a:hover,
        .header-nav a.active {
            color: var(--accent);
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: 1px solid #333;
            color: var(--paper);
            font-size: 1.8rem;
            padding: 0.25rem 1rem;
            border-radius: 6px;
            cursor: pointer;
            min-width: 50px;
            min-height: 44px;
        }

        .btn {
            padding: 0.6rem 1.2rem;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s;
            border: 1px solid transparent;
            min-height: 44px;
            display: inline-block;
        }

        .btn-outline {
            background: transparent;
            color: var(--paper);
            border-color: #333;
        }

        .btn-outline:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        /* Main Content */
        .blog-main {
            flex: 1;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            padding: 2rem 1.5rem;
        }

        .blog-title {
            font-family: var(--display);
            font-size: clamp(2rem, 6vw, 3rem);
            font-weight: 900;
            margin-bottom: 1rem;
            text-align: center;
        }

        .blog-subtitle {
            text-align: center;
            color: var(--dim);
            font-size: clamp(1rem, 3vw, 1.2rem);
            margin-bottom: 3rem;
        }

        /* Featured Post */
        .featured-post {
            background: #0d0d0d;
            border: 1px solid #1a1a1a;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 3rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            padding: 2rem;
        }

        .featured-image {
            background: #1a1a1a;
            border-radius: 8px;
            overflow: hidden;
            aspect-ratio: 16/9;
        }

        .featured-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .featured-content h2 {
            font-family: var(--display);
            font-size: 1.8rem;
            margin-bottom: 1rem;
        }

        .featured-content h2 a {
            color: var(--paper);
            text-decoration: none;
        }

        .featured-content h2 a:hover {
            color: var(--accent);
        }

        .featured-meta {
            color: var(--dim);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .featured-excerpt {
            color: #ccc;
            margin-bottom: 1.5rem;
        }

        .read-more {
            color: var(--accent);
            text-decoration: none;
            font-weight: 500;
        }

        .read-more:hover {
            text-decoration: underline;
        }

        /* Blog Grid */
        .blog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 2rem;
            margin: 2rem 0;
        }

        .blog-card {
            background: #0d0d0d;
            border: 1px solid #1a1a1a;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.2s, border-color 0.2s;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .blog-card:hover {
            transform: translateY(-4px);
            border-color: var(--accent);
        }

        .card-image {
            width: 100%;
            aspect-ratio: 16/9;
            background: #1a1a1a;
        }

        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .card-content {
            padding: 1.5rem;
            flex: 1;
        }

        .card-category {
            color: var(--accent);
            font-size: 0.8rem;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            display: block;
        }

        .card-title {
            font-family: var(--display);
            font-size: 1.3rem;
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }

        .card-title a {
            color: var(--paper);
            text-decoration: none;
        }

        .card-title a:hover {
            color: var(--accent);
        }

        .card-meta {
            color: var(--dim);
            font-size: 0.8rem;
            margin-bottom: 0.75rem;
        }

        .card-excerpt {
            color: #999;
            font-size: 0.9rem;
            line-height: 1.6;
        }

        /* Categories */
        .categories {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            justify-content: center;
            margin: 2rem 0;
        }

        .category-tag {
            background: #1a1a1a;
            padding: 0.5rem 1rem;
            border-radius: 30px;
            color: var(--dim);
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s;
            border: 1px solid #2a2a2a;
        }

        .category-tag:hover,
        .category-tag.active {
            background: var(--accent);
            color: var(--ink);
            border-color: var(--accent);
        }

        /* Newsletter */
        .newsletter {
            background: #0d0d0d;
            border: 1px solid #1a1a1a;
            border-radius: 12px;
            padding: 3rem 2rem;
            text-align: center;
            margin: 3rem 0;
        }

        .newsletter h2 {
            font-family: var(--display);
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .newsletter p {
            color: var(--dim);
            margin-bottom: 2rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .newsletter-form {
            display: flex;
            gap: 1rem;
            max-width: 500px;
            margin: 0 auto;
        }

        .newsletter-input {
            flex: 1;
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            padding: 1rem;
            border-radius: 6px;
            color: var(--paper);
            font-family: var(--mono);
            font-size: 1rem;
            min-height: 48px;
        }

        .newsletter-input:focus {
            outline: none;
            border-color: var(--accent);
        }

        .newsletter-btn {
            background: var(--accent);
            color: var(--ink);
            border: none;
            padding: 0 2rem;
            border-radius: 6px;
            font-family: var(--mono);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            min-height: 48px;
            white-space: nowrap;
        }

        .newsletter-btn:hover,
        .newsletter-btn:active {
            background: #d4ff26;
            transform: translateY(-2px);
        }

        /* Footer */
        .blog-footer {
            background: #0d0d0d;
            border-top: 1px solid #1a1a1a;
            padding: 2rem 1.5rem 1rem;
            margin-top: auto;
        }

        .footer-container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 2rem;
        }

        .footer-section h4 {
            font-family: var(--display);
            color: var(--paper);
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section li {
            margin-bottom: 0.5rem;
        }

        .footer-section a {
            color: var(--dim);
            text-decoration: none;
            font-size: 0.85rem;
        }

        .footer-section a:hover {
            color: var(--accent);
        }

        .footer-bottom {
            text-align: center;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid #1a1a1a;
            color: #333;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .header-container {
                padding: 0.75rem 1rem;
            }

            .mobile-menu-btn {
                display: block;
            }

            .header-nav {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: #0a0a0a;
                flex-direction: column;
                padding: 1rem;
                border-bottom: 1px solid #1a1a1a;
            }

            .header-nav.show {
                display: flex;
            }

            .header-nav a {
                width: 100%;
                text-align: center;
                padding: 0.75rem;
            }

            .header-actions {
                display: none;
            }

            .featured-post {
                grid-template-columns: 1fr;
                padding: 1.5rem;
            }

            .blog-grid {
                grid-template-columns: 1fr;
            }

            .newsletter-form {
                flex-direction: column;
            }

            .footer-container {
                grid-template-columns: 1fr;
                text-align: center;
            }
        }

        @media (max-width: 480px) {
            .blog-main {
                padding: 1rem;
            }

            .featured-post {
                padding: 1rem;
            }

            .card-content {
                padding: 1rem;
            }

            .newsletter {
                padding: 2rem 1rem;
            }
        }
    </style>
</head>
<body>
